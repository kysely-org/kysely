import { writeFile } from 'node:fs/promises'
import { hastToHtml } from 'shiki'
import { highlightCode } from '../plugins/remark-shiki.mjs'

const preamble = `import type { ExpressionBuilder, Generated, Kysely } from 'kysely'
import { jsonArrayFrom } from 'kysely/helpers/postgres'

interface DB {
  person: {
    id: Generated<number>
    first_name: string
    age: number
  }
  pet: {
    id: Generated<number>
    name: string
    species: 'dog' | 'cat'
    owner_id: number
  }
}

declare const db: Kysely<DB>
// ---cut---
`

const compilerSnippet = `// @errors: 2345
const rows = await db
  .selectFrom('person')
  .select('first_name')
  .where('person.ag', '>', 18)
  .execute()`

const compositionSnippet = `function withPets(
  eb: ExpressionBuilder<DB, 'person'>,
) {
  const pets = eb
    .selectFrom('pet')
    .select(['name', 'species'])
    .whereRef('owner_id', '=', 'person.id')
  return jsonArrayFrom(pets).as('pets')
}

const person = await db
  .selectFrom('person')
  .select(['id', 'first_name'])
  .select(withPets)
  .executeTakeFirstOrThrow()

const species = person.pets[0]?.species`

const popups: string[] = []
const popupIds = new Map<string, number>()

function collectPopup(content: { children: [{ children: unknown[] }] }) {
  const html = hastToHtml({
    type: 'root',
    children: content.children[0].children,
  } as never)
  let id = popupIds.get(html)
  if (id === undefined) {
    id = popups.push(html) - 1
    popupIds.set(html, id)
  }
  return id
}

interface Twoslash {
  errors: { code: number; text: string }[]
}

async function highlight(name: string, code: string) {
  let twoslash: Twoslash | undefined
  const html = await highlightCode(`${preamble}${code}`, {
    lang: 'ts',
    twoslash: true,
    collectPopup,
    transformers: [
      {
        name: 'homepage-panels',
        root(root: { children: unknown[] }) {
          twoslash = this.meta.twoslash
          type Node = {
            type: string
            value?: string
            properties?: { class?: string }
            children?: Node[]
          }
          const isLine = (node?: Node) => node?.properties?.class === 'line'
          function strip(node: Node) {
            if (!node.children) return
            const children: Node[] = []
            for (const child of node.children) {
              if (child.properties?.class?.includes('twoslash-meta-line')) {
                continue
              }
              const previous = children.at(-1)
              if (isLine(previous) && isLine(child)) {
                children.push({ type: 'text', value: '\n' })
              }
              if (child.value === '\n' && previous?.value === '\n') continue
              children.push(child)
            }
            node.children = children
            children.forEach(strip)
          }
          strip(root as never)
        },
      },
    ],
  }).catch((error) => {
    throw new Error(`Failed to type-check the homepage ${name} snippet`, {
      cause: error,
    })
  })
  return { html, twoslash: twoslash! }
}

const compiler = await highlight('compiler', compilerSnippet)
const composition = await highlight('composition', compositionSnippet)

const [error] = compiler.twoslash.errors

const header = `// THIS FILE IS GENERATED BY \`site/scripts/highlight-snippets.mts\`
// DO NOT EDIT THIS FILE DIRECTLY
`

await Promise.all([
  writeFile(
    new URL('../src/components/snippets.generated.ts', import.meta.url),
    `${header}
export const compilerSnippetHtml = ${JSON.stringify(compiler.html)}

export const compilerError = ${JSON.stringify({ code: error.code, text: error.text })}

export const compositionSnippetHtml = ${JSON.stringify(composition.html)}
`,
  ),
  writeFile(
    new URL('../src/components/snippets-popups.generated.ts', import.meta.url),
    `${header}export const POPUPS: readonly string[] = ${JSON.stringify(popups)}\n`,
  ),
])

console.log(
  `highlighted homepage snippets with ${popups.length} unique type popups`,
)
