import { writeFile } from 'node:fs/promises'
import { hastToHtml } from 'shiki'
import { highlightCode } from '../plugins/remark-shiki.mjs'
import {
  DIALECTS,
  PACKAGE_MANAGERS,
  type Dialect,
  type PackageManager,
} from '../docs/getting-started/constants.ts'
import {
  databaseCode,
  repositoryCode,
  specCode,
  typesCode,
} from '../docs/getting-started/snippets.ts'

function files(dialect: Dialect, packageManager: PackageManager) {
  return [
    [
      'globals.d.ts',
      '/// <reference types="node" />\n/// <reference types="mocha" />',
      false,
    ],
    ['types.ts', typesCode(packageManager), true],
    ['database.ts', databaseCode(dialect, packageManager), true],
    ['PersonRepository.ts', repositoryCode(dialect), true],
    ['PersonRepository.spec.ts', specCode(dialect, packageManager), true],
  ] as const
}

const popups: string[] = []
const popupIds = new Map<string, number>()

function collectPopup(content: { children: [{ children: unknown[] }] }) {
  const html = hastToHtml({
    type: 'root',
    children: content.children[0].children,
  } as never)
  let id = popupIds.get(html)
  if (id === undefined) {
    id = popups.push(html) - 1
    popupIds.set(html, id)
  }
  return id
}

const highlighted: Record<string, string> = {}

for (const dialect of DIALECTS) {
  for (const packageManager of PACKAGE_MANAGERS) {
    const variant = files(dialect, packageManager)

    for (const [index, [name, code, shown]] of variant.entries()) {
      if (!shown || code in highlighted) continue

      const context = variant
        .slice(0, index)
        .map(([name, code]) => `// @filename: ${name}\n${code}`)
        .join('\n')

      try {
        highlighted[code] = await highlightCode(
          `${context}\n// @filename: ${name}\n// ---cut---\n${code}`,
          { lang: 'ts', twoslash: true, collectPopup },
        )
      } catch (error) {
        throw new Error(
          `Failed to type-check ${name} (${dialect}, ${packageManager})`,
          { cause: error },
        )
      }
    }
  }
}

const header = `// THIS FILE IS GENERATED BY \`site/scripts/highlight-getting-started.mts\`
// DO NOT EDIT THIS FILE DIRECTLY
`

await Promise.all([
  writeFile(
    new URL('../docs/getting-started/code.generated.ts', import.meta.url),
    `${header}export const HIGHLIGHTED_CODE: Record<string, string> = ${JSON.stringify(highlighted)}\n`,
  ),
  writeFile(
    new URL('../docs/getting-started/popups.generated.ts', import.meta.url),
    `${header}export const POPUPS: readonly string[] = ${JSON.stringify(popups)}\n`,
  ),
])

console.log(
  `highlighted ${Object.keys(highlighted).length} getting started snippets with ${popups.length} unique type popups`,
)
